{
  "name": "p5_electron",
  "version": "1.0.0",
  "description": "A p5.js project with Electron and Syphon",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:vscode": "env -u ELECTRON_RUN_AS_NODE electron .",
    "start:fullscreen": "electron . --fullscreen",
    "start:custom": "electron . --size 1024 768",
    "dev": "electron . --hot-reload",
    "build": "electron-builder build --mac --universal",
    "install": "node-gyp rebuild",
    "clean": "node-gyp clean",
    "rebuild": "node-gyp rebuild --mac --x64",
    "configure": "node-gyp configure",
    "build:x64": "node-gyp rebuild --arch=x64",
    "build:arm64": "node-gyp rebuild --arch=arm64"
  },
  "keywords": [],
  "author": "miflck",
  "license": "ISC",
  "devDependencies": {
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "electron-reloader": "^1.2.3",
    "node-gyp": "^9.0.0"
  },
  "dependencies": {
    "bindings": "^1.5.0",
    "node-addon-api": "^3.0.0",
    "p5": "^1.10.0"
  },
  "build": {
    "appId": "ch.miflck.electronexample",
    "productName": "My P5.js Electron App with Syphon",
    "files": [
      "main.js",
      "ui/**/*",
      "src/**/*",
      "node_modules/**/*",
      "build/Release/syphon_addon.node",
      "build/Release/frameworks/**/*",
      "**/*",
      "!frameworks${/*}"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "resources/icon.icns",
      "target": "dmg",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "frameworks",
          "to": "Frameworks"
        }
      ]
    }
  }
}
